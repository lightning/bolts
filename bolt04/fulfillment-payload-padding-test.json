{
    "comment": "Standalone fulfillment_payload_tlvs padding examples. input_tlvs is a list of records with numeric types and hex-encoded values. encoded_tlv_stream is the resulting hex-encoded serialized TLV stream, excluding the 16-byte Poly1305 tag. Application records use custom odd type 65537. These examples choose zero-valued padding and the smallest achievable positive multiple of 256 bytes; the specification does not require the smallest multiple above 256 bytes.",
    "tests": [
        {
            "comment": "An empty stream needs 508 padding bytes: a type 1 padding record cannot serialize to exactly 256 bytes.",
            "input_tlvs": [],
            "encoded_tlv_stream": ""
        },
        {
            "comment": "The application TLV from the existing fulfillment payload example needs 245 padding bytes to reach 256 bytes.",
            "input_tlvs": [
                {
                    "type": 65537,
                    "value": "070809"
                }
            ],
            "encoded_tlv_stream": ""
        },
        {
            "comment": "A 254-byte stream needs a present but empty padding record to reach 256 bytes.",
            "input_tlvs": [
                {
                    "type": 65537,
                    "value": ""
                }
            ],
            "encoded_tlv_stream": ""
        },
        {
            "comment": "A 255-byte stream cannot fit a padding record in the remaining byte, so it needs 253 padding bytes to reach 512 bytes.",
            "input_tlvs": [
                {
                    "type": 65537,
                    "value": ""
                }
            ],
            "encoded_tlv_stream": ""
        },
        {
            "comment": "A 256-byte stream is already aligned and must omit the padding record.",
            "input_tlvs": [
                {
                    "type": 65537,
                    "value": ""
                }
            ],
            "encoded_tlv_stream": ""
        },
        {
            "comment": "A 257-byte stream cannot reach 512 bytes: the padding record size jumps from 254 to 257 bytes when its value length reaches 253. It needs 507 padding bytes to reach 768 bytes.",
            "input_tlvs": [
                {
                    "type": 65537,
                    "value": ""
                }
            ],
            "encoded_tlv_stream": ""
        },
        {
            "comment": "A 258-byte stream needs 252 padding bytes to reach 512 bytes, using a one-byte BigSize length.",
            "input_tlvs": [
                {
                    "type": 65537,
                    "value": ""
                }
            ],
            "encoded_tlv_stream": ""
        },
        {
            "comment": "A 512-byte stream is already aligned and must omit the padding record.",
            "input_tlvs": [
                {
                    "type": 65537,
                    "value": ""
                }
            ],
            "encoded_tlv_stream": ""
        }
    ]
}
